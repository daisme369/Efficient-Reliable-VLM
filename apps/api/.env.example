# Set real values in your process environment; this file is not loaded implicitly.
DATABASE_URL=postgresql+psycopg://<runtime-user>:<password>@<host>:<port>/<database>
SESSION_SECRET=<generate-at-least-32-random-characters>
IDEMPOTENCY_HASH_SECRET=<generate-a-separate-random-secret>
INFERENCE_SERVICE_TOKEN=<generate-a-separate-private-service-secret>
APP_ORIGIN=http://localhost:3000
ALLOW_INSECURE_LOOPBACK_COOKIE=true
THORAX_POLICY_PATH=<absolute-path-to-apps/api/policy.toml>
IMAGE_STORAGE_ROOT=<absolute-private-canonical-image-directory>
FIXTURE_ROOT=<absolute-private-fixture-directory>
INFERENCE_BASE_URL=http://127.0.0.1:8001
AI_PROVIDER_MODE=mock
THORAX_MOCK_RESPONSES_PATH=<absolute-path-to-reviewed-mock-response-json>
# For AI_PROVIDER_MODE=real, on the approved offline Linux GPU environment:
THORAX_REAL_CONFIG=<absolute-path-to-infra/real.inference.toml>
THORAX_CV_URL=<private-detector-origin>
THORAX_CV_TOKEN=<separate-private-detector-secret>
