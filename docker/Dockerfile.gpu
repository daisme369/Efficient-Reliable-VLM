# syntax=docker/dockerfile:1.7

FROM ghcr.io/astral-sh/uv:0.11.21@sha256:6f1fa8fc4040ad7197d7e652057219871e5f6640abfe2b790f1419fdb2319e6b AS uv

# Linux/amd64 digest for python:3.12.12-slim-bookworm, verified 2026-10-09.
FROM python:3.12.12-slim-bookworm@sha256:2986c55feb36e6cae00fa1fefb454283e4b33f35e75ff8bdd123b134130be301

LABEL org.opencontainers.image.title="Efficient-Reliable-VLM GPU environment"
LABEL org.opencontainers.image.description="CUDA 13.0 Python environment for approved Radiology VQA GPU profiles"

ENV HF_HOME=/home/researcher/.cache/huggingface \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TORCH_HOME=/home/researcher/.cache/torch \
    UV_NO_CACHE=1

COPY --from=uv /uv /uvx /bin/
COPY requirements.txt requirements/gpu-runtime.txt requirements/gpu-cu130.txt /tmp/requirements/

RUN uv pip install --system \
        --default-index https://pypi.org/simple \
        --requirement /tmp/requirements/requirements.txt \
        --requirement /tmp/requirements/gpu-runtime.txt \
    && uv pip install --system --no-deps \
        --default-index https://download.pytorch.org/whl/cu130 \
        --requirement /tmp/requirements/gpu-cu130.txt \
    && python -m pip check \
    && python -c "from importlib.metadata import version; assert version('torch') == '2.14.1+cu130'; assert version('torchvision') == '0.29.1+cu130'; assert version('bitsandbytes') == '0.50.2'" \
    && useradd --create-home --uid 10001 researcher \
    && mkdir -p /workspace "${HF_HOME}" "${TORCH_HOME}" \
    && chown -R researcher:researcher /workspace /home/researcher \
    && rm -rf /tmp/requirements

USER researcher
WORKDIR /workspace

CMD ["python"]
