# Thorax AI web app (src/thorax-web), run by docker/compose.yaml.

FROM node:22.20.0-bookworm-slim@sha256:b21fe589dfbe5cc39365d0544b9be3f1f33f55f3c86c87a76ff65a02f8f5848e

# Next.js fixes the /api/v1 rewrite and the pages' mock-or-real switch at build time, so the API origin is a build argument.
ARG THORAX_API_ORIGIN=http://api:8000
ENV THORAX_API_ORIGIN=${THORAX_API_ORIGIN} \
    NEXT_TELEMETRY_DISABLED=1

RUN npm install --global pnpm@10.34.9 && mkdir /app && chown node:node /app
USER node
WORKDIR /app

COPY --chown=node:node src/thorax-web/package.json src/thorax-web/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY --chown=node:node src/thorax-web ./
RUN pnpm build

EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD ["node", "-e", "fetch('http://127.0.0.1:3000/login').then(r => process.exit(r.ok ? 0 : 1), () => process.exit(1))"]
CMD ["node_modules/.bin/next", "start", "--hostname", "0.0.0.0", "--port", "3000"]
