# Set two distinct local demo passwords, each 12–72 UTF-8 bytes.
THORAX_DEMO_DOCTOR_PASSWORD=
THORAX_DEMO_ADMIN_PASSWORD=
# Backend only (python -m thorax_api.accounts seed-demo): password for the two demo annotators.
THORAX_DEMO_ANNOTATOR_PASSWORD=

# Optional absolute path for isolated synthetic demo state.
THORAX_DEMO_STATE_PATH=

# Optional origin of a contract-compatible API. Setting it disables the local demo API.
THORAX_API_ORIGIN=
